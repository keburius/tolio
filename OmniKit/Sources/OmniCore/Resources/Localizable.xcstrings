      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press the key twice and keep holding it: the cheat sheet stays while you hold. Click an item to run it. Its shortcut (⌃⌥⌘/ unless you changed it) or the Launcher keeps it open until you press Esc, with a filter field."
