      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search the Web, Open Link and Translate act only when you click them. Search the Web and Open Link hand the text to your browser; Translate uses Apple's translation panel (the same as Translate in context menus)."
          }
