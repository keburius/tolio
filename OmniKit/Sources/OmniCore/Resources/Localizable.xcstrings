      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading the numbers costs almost nothing, but redrawing the menu bar does, so a longer interval saves energy. Measured: about 1.7% CPU at 2 seconds, 0.7% at 5 seconds, 0.2% with only the icon."
          }
        }
