      }
    },
    "textactions.settings.copyBriefly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When an app doesn't share its selection, copy it briefly (⌘C) and put your clipboard back"
          }
        }
      }
    },
    "textactions.settings.copyBrieflyNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed for many apps, such as Slack, Discord and Chrome. Tolio puts your previous clipboard back right away, and Clipboard History doesn't keep it. Never used in password fields, while you're typing a password, in password managers, or in Finder."
          }
        }
      }
    },
