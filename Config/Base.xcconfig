// Signing. No Apple Development certificate exists yet, so builds are ad-hoc signed
// ("Sign to Run Locally"). To sign with a real identity, create Config/Signing.local.xcconfig
// (git-ignored) containing:
//   CODE_SIGN_STYLE = Automatic
//   CODE_SIGN_IDENTITY = Apple Development
//   DEVELOPMENT_TEAM = <your team id>
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
